# Copie para backend/.env e ajuste na VPS.
# O backend lê este arquivo quando é iniciado a partir da pasta backend/.

# Interface e porta do Spring Boot
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080

# Origens permitidas no CORS, separadas por vírgula (ex.: https://seu-dominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swagger UI e especificação OpenAPI (use false para esconder em produção)
SWAGGER_ENABLED=true
API_DOCS_ENABLED=true
