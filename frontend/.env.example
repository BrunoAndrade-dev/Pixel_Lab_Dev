# Copie para frontend/.env e ajuste na VPS.

# Endereço do backend Spring. O Next.js encaminha /api/* para cá.
# Atenção: o valor é fixado no "npm run build"; refaça o build ao mudar.
SPRING_API_URL=http://127.0.0.1:8080

# Porta do "npm start" (o Next lê PORT do ambiente do processo, não deste arquivo).
# Na VPS use: PORT=3000 npm start
